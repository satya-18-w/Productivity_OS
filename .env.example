# Copy to .env for local development. Never commit .env.

# PostgreSQL connection string (pgx / pgxpool).
DATABASE_URL=postgres://productivity_os:productivity_os@localhost:5433/productivity_os?sslmode=disable

# Separate database for integration tests. Its tables are truncated between tests.
# Create it once: docker exec productivity_os_pg createdb -U productivity_os productivity_os_test
TEST_DATABASE_URL=postgres://productivity_os:productivity_os@localhost:5433/productivity_os_test?sslmode=disable

# HTTP listen port.
PORT=8080

# Environment: development | production. Controls cookie Secure flag and log format.
ENV=development

# Absolute session lifetime (Go duration).
SESSION_TTL=720h

# Graceful shutdown grace period (Go duration).
SHUTDOWN_GRACE=10s
